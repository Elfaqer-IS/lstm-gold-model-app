import streamlit as st
import yfinance as yf
import numpy as np
import pandas as pd
from tensorflow.keras.models import load_model
from sklearn.preprocessing import MinMaxScaler

# =========================
# LOAD MODEL
# =========================

model = load_model("gold_model.h5")

st.title("📊 GOLD LSTM DASHBOARD")

# =========================
# DATA
# =========================

data = yf.download("GC=F", period="2y", interval="1d")
data = data[['Close']].dropna()

# =========================
# SCALE
# =========================

scaler = MinMaxScaler()
scaled = scaler.fit_transform(data)

window = 60

real_prices = data['Close'].values

# =========================
# PREDICTION (LAST WINDOW ONLY)
# =========================

x_input = scaled[-window:]
x_input = np.array([x_input])
x_input = np.reshape(x_input, (1, window, 1))

pred = model.predict(x_input, verbose=0)

dummy = np.zeros((1,1))
dummy[0,0] = pred[0,0]

next_price = scaler.inverse_transform(dummy)[0,0]

current_price = real_prices[-1]

# =========================
# SIGNAL
# =========================

signal = "BUY 📈" if next_price > current_price else "SELL 📉"

# =========================
# DISPLAY
# =========================

st.metric("Current Price", round(current_price, 2))
st.metric("Predicted Price", round(next_price, 2))

st.subheader("Signal")
st.write(signal)
